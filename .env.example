# ── MEGA-AI │ کلیدهای API ─────────────────────────────────────────
# هر پرووایدری که کلید داشته باشد، خودکار وارد «پنل خبرگان» می‌شود.
# فایل واقعی: .env   (این نمونه را کپی کن:  cp .env.example .env)

# ════ گیت‌وی‌های ایرانی — بدون فیلترشکن، پرداخت ریالی، یک کلید برای همه‌ی مدل‌ها ════
AVALAI_API_KEY=
# https://avalai.ir                        (GPT، Claude، Gemini)
GAPGPT_API_KEY=
# https://gapgpt.app/ai-api
METIS_API_KEY=
# https://metisai.ir
WINK_API_KEY=
# https://winkapi.net
SINOX_API_KEY=
# https://sinoxapi.com
JARVIS_API_KEY=
# https://jarvis.you

# ════ سرویس سفارشی (Ollama، vLLM، LM Studio، هر آدرس سازگار با OpenAI) ════
CUSTOM_API_KEY=
CUSTOM_BASE_URL=          # مثلاً http://localhost:11434/v1
CUSTOM_MODELS=            # مثلاً llama3.1,qwen2.5

# ════ بهترین گزینه برای شروع (با یک کلید، ده‌ها مدل: GPT، Claude، Gemini، Grok، DeepSeek، Qwen، Llama)
OPENROUTER_API_KEY=
# https://openrouter.ai/keys

OPENAI_API_KEY=
# https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
# https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
# https://aistudio.google.com/apikey
XAI_API_KEY=
# https://console.x.ai
DEEPSEEK_API_KEY=
# https://platform.deepseek.com/api_keys
GROQ_API_KEY=
# https://console.groq.com/keys

# ── گیت‌هاب (برای فرستادن پروژه/خروجی‌ها روی حساب خودت)
# توکن از: github.com/settings/tokens  (دسترسی repo کافی است)
GITHUB_TOKEN=
# اگر روی سرور دیگری (GitHub Enterprise) هستی:
# GITHUB_API=https://api.github.com

# ── ابزارهای پژوهش وب (اختیاری؛ بدون آن‌ها از DuckDuckGo رایگان استفاده می‌شود)
TAVILY_API_KEY=
# https://app.tavily.com  (۱۰۰۰ جست‌وجوی رایگان در ماه)
BRAVE_API_KEY=
SERPER_API_KEY=

# ── تنظیمات اجرا
MEGA_PANEL_SIZE=4          # چند خبره موازی
MEGA_CRITIQUE_ROUNDS=1     # چند دور نقد متقابل
MEGA_VERIFY=true           # بازبینی نهایی
MEGA_USE_TOOLS=true        # ابزارها فعال
MEGA_MAX_TOOL_ROUNDS=3

# ── ایران / شبکه
MEGA_PROXY=                 # http://127.0.0.1:7890  یا  socks5://127.0.0.1:1080
MEGA_PROXY_SCOPE=foreign    # foreign = پروکسی فقط برای سرویس‌های خارجی | all = همه
MEGA_AUTO_FALLBACK=true     # اگر یک سرویس خوابید، خودکار برود سراغ بعدی

# ── قدرت مدل‌ها
MEGA_MODEL_TIER=max         # max (قوی‌ترین) | balanced | cheap

# ── کارگزار مطلق
MEGA_AGENT_MAX_STEPS=24     # سقف گام‌های اجرا (۰ = بی‌نهایت)

# ── دستیار تلگرام (توکن از @BotFather)
TELEGRAM_BOT_TOKEN=
